<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onbPager"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/onbBottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout android:id="@+id/onbBottomBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/onbDots"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            app:tabBackground="@drawable/tab_dot_selector"
            app:tabGravity="start" app:tabIndicatorHeight="0dp"/>

        <TextView android:id="@+id/onbSkip"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="20dp" android:text="@string/skip"
            android:textColor="@color/text_secondary"/>

        <TextView android:id="@+id/onbNext"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/continue_label"
            android:textColor="@color/navy" android:textStyle="bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
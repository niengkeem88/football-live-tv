<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card"
    android:layout_margin="6dp" android:padding="12dp">

    <TextView android:id="@+id/fxLeague"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text_secondary" android:textSize="12sp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <ImageView android:id="@+id/fxHomeLogo"
            android:layout_width="28dp" android:layout_height="28dp"/>
        <TextView android:id="@+id/fxHomeName" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:textColor="@color/text_primary"/>
        <TextView android:id="@+id/fxScore"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/navy" android:textStyle="bold" android:textSize="16sp"/>
        <TextView android:id="@+id/fxAwayName" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end" android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary"/>
        <ImageView android:id="@+id/fxAwayLogo"
            android:layout_width="28dp" android:layout_height="28dp"/>
    </LinearLayout>

    <TextView android:id="@+id/fxStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/live_green"
        android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
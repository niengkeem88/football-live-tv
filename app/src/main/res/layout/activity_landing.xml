<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background"
    android:gravity="center_horizontal" android:padding="20dp">

    <ImageView android:layout_width="90dp" android:layout_height="90dp"
        android:layout_marginTop="24dp" android:src="@mipmap/ic_launcher"/>

    <TextView android:id="@+id/landingSelected"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="@color/text_secondary"/>

    <Button android:id="@+id/landingOpen"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:backgroundTint="@color/navy"
        android:text="@string/open" android:textColor="@color/white"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="horizontal" android:weightSum="3">
        <TextView android:id="@+id/landingRate" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
            android:padding="16dp" android:text="⭐\nRate Us"/>
        <TextView android:id="@+id/landingShare" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
            android:padding="16dp" android:text="🔗\nShare"/>
        <TextView android:id="@+id/landingPrivacy" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
            android:padding="16dp" android:text="🛡\nPrivacy"/>
    </LinearLayout>
</LinearLayout>